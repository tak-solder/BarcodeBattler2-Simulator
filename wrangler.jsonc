{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barcode-battler-ii",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barcode-battler-ii",
      "database_id": "b5bc0100-081e-4f0c-96ae-51e78419f0ff",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "barcode-battler-ii"
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "barcode-battler-ii-preview",
        "database_id": "bb7c3a56-ec00-4782-9de4-5b856dc797d2",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "barcode-battler-ii-preview"
      }
    ]
  }
}
