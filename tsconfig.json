{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src/client/**/*.ts", "src/engine/**/*.ts", "src/engine/**/*.js"]
}
